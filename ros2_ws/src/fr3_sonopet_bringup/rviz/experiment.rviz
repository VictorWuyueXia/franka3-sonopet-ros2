Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: In Hand RGB
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /in_hand_d405/d405_in_hand/color/image_rect_raw
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Fixed RGB
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /fixed_d405/d405_fixed/color/image_rect_raw
      Value: true
  Global Options:
    Fixed Frame: fr3_link0
