# Cartesian center selected by the operator or perception system.
geometry_msgs/Point selected_center

# True when selected_center should replace the trajectory node's stored center.
bool update_selected_center

---
# True when a geometrically valid raster plan was generated.
bool success

# Human-readable diagnostic message for logs and operator feedback.
string message

# Complete raster trajectory and associated planning metadata.
fr3_sonopet_interfaces/RasterPlan plan

---
# Current high-level planning phase reported by the action server.
string phase
