<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fr3_sonopet_tool">
  <xacro:arg name="parent_frame" default="fr3_link8"/>
  <xacro:arg name="tool_frame" default="sonopet_tcp"/>
  <xacro:arg name="xyz" default="0.005 0.010 0.026"/>
  <xacro:arg name="rpy" default="0 0 0"/>

  <!-- The tool frame is a calibrated fixed TCP used for planning and TF lookup. -->
  <link name="$(arg tool_frame)"/>

  <!-- A massless fixed joint keeps the robot model explicit without adding dynamics. -->
  <joint name="$(arg tool_frame)_joint" type="fixed">
    <parent link="$(arg parent_frame)"/>
    <child link="$(arg tool_frame)"/>
    <origin xyz="$(arg xyz)" rpy="$(arg rpy)"/>
  </joint>
</robot>
