<?xml version="1.0"?>
<package format="3">
  <name>fr3_sonopet_pointcloud</name>
  <version>0.1.0</version>
  <description>Pointcloud capture, base-frame processing, and PCD artifacts for the FR3 Sonopet experiment.</description>
  <maintainer email="victor@example.com">Victor Xia</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>fr3_sonopet_interfaces</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <test_depend>pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
